<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit: [Fact], [Theory] en Assert -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Start de echte backend in het geheugen voor HTTP-integratietesten -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Code coverage meten (zie readme, deel Testen) -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- De backend die we testen -->
    <ProjectReference Include="..\..\backend\SmartEnvironment.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hierdoor hoef je niet in elk testbestand "using Xunit;" te zetten -->
    <Using Include="Xunit" />
  </ItemGroup>

</Project>